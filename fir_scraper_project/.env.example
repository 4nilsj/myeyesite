# ==============================================================
# FIR Scraper Configuration
# Copy this file to .env and fill in your values from browser
# ==============================================================

# Secret key for Flask session signing (flash messages, etc).
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# If unset, a random key is generated per process (sessions won't survive a restart).
FLASK_SECRET_KEY=

# ----------------------------------------------------------------
# Session Credentials (copy from browser DevTools → Network tab)
# These expire when your browser session ends — refresh as needed
# ----------------------------------------------------------------

# Captcha text shown on the FIR search page
FIR_CAPTCHA=RKELR

# CSRF token from the form (changes each session)
FIR_CSRF_TOKEN=1be9b9bbe415ddff5aeebff6c29523f7ab8fb5f40c95c421cb5aceed0f5a4f9d

# ----------------------------------------------------------------
# Session Cookies (from Browser DevTools → Application → Cookies)
# ----------------------------------------------------------------
FIR_COOKIE_PHPSESSID=mmek5vakg578uacv5fnr7kpvjo
FIR_COOKIE_XSRF_TOKEN=eyJpdiI6ImhxYVJtV1Y2cVBSTTdKRWRobWo5TFE9PSIsInZhbHVlIjoiSVJGXC8ybzZ0enEwblFqSjYrT2xQeVdqdFMzdTBxQUYxdERadzhTTXR1dXNINlwvNFRQMnJ0eXZTdURIUnN1a2NlIiwibWFjIjoiZDU1N2NlZGRiODQ2ZDIzYzAzY2IzODJkYWExZGQ3MGUwMTljZmE5MGUwN2JlYzI0YjZlN2IxY2I1NjhlN2QyYiJ9
