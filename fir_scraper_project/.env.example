# ----------------------------------------------------------------
# FIR Search Parameters (usually fixed)
# ----------------------------------------------------------------
FIR_YEAR=2026
FIR_DISTRICT_ID=23

# Police Station ID — choose one OR use --station flag in run.sh
#
#   ID    Name                   CLI shortcut      Filename pattern
#   717   Madbool Station        --station madbool fir_ps717_XXXX.pdf
#   718   Kalagi Station         --station kalagi  fir_ps718_XXXX.pdf
#   2256  Cybercrime Station     --station cyber   fir_ps2256_XXXX.pdf
#
# This value is the fallback when run.sh is used without --station.
FIR_PS_ID=717

# Target API endpoint
FIR_URL=https://ksp.karnataka.gov.in/fir_search_new_api.php
