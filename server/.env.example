PORT=5001

# Allowed origin for CORS — set to your deployed client URL in production
CORS_ORIGIN=http://localhost:5173

# Set to 'foursquare' to use Foursquare Places + Nominatim geocoding (free tier)
# Leave unset or set to 'google' to use Google Places + Google Geocoding
PLACES_PROVIDER=google

# Required when PLACES_PROVIDER=google (or unset)
GOOGLE_SERVER_API_KEY=your_google_server_api_key_here

# Required when PLACES_PROVIDER=foursquare
# Sign up free at https://developer.foursquare.com
FOURSQUARE_API_KEY=your_foursquare_api_key_here
